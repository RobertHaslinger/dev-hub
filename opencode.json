{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.personal.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow"
    }
  },
  "plugin": [
    "opencode-agent-memory"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--channel=canary",
        "--isolated=true"]
    }
  }
}
